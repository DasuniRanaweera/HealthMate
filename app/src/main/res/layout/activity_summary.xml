<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F7F5FF"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="HealthMate logo"
            android:src="@drawable/healthmate_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="HealthMate"
            android:textColor="#34235F"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Today's Summary"
        android:textColor="#26134F"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textSummaryDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#5C5771"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/textSummarySteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/menu_button_light"
        android:padding="20dp"
        android:textColor="#34235F"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/textSummaryCalories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/menu_button_light"
        android:padding="20dp"
        android:textColor="#34235F"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/textSummaryWater"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/menu_button_teal"
        android:padding="20dp"
        android:textColor="#075C60"
        android:textSize="20sp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/water_illustration"
        android:scaleType="fitCenter"
        android:src="@drawable/water_illustration" />

    <TextView
        android:id="@+id/textWaterGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/water_goal_progress"
        android:textColor="#075C60"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressWater"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#16A6A2" />

    <TextView
        android:id="@+id/textWaterMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#075C60"
        android:textSize="16sp" />


</LinearLayout>
</ScrollView>