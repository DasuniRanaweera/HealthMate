<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FF"
    tools:context=".AddRecordActivity">

    <LinearLayout
        android:id="@+id/headerHealthMate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/healthmate_logo"
            android:src="@drawable/healthmate_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="HealthMate"
            android:textColor="#34235F"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/titleAddRecord"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:text="@string/add_record"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#26134F"
        app:layout_constraintTop_toBottomOf="@id/headerHealthMate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <Button
        android:id="@+id/buttonSelectDate"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:minHeight="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:text="@string/select_date"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/titleAddRecord"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Steps -->
    <TextView
        android:id="@+id/labelSteps"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="12dp"
        android:labelFor="@id/inputSteps"
        android:text="@string/steps_walked"
        android:textColor="#26134F"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/inputSteps"
        app:layout_constraintTop_toTopOf="@id/inputSteps"
        app:layout_constraintBottom_toBottomOf="@id/inputSteps" />

    <EditText
        android:id="@+id/inputSteps"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/input_box_background"
        android:hint="@string/steps"
        android:inputType="number"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#000000"
        android:textColorHint="#595466"
        android:textSize="16sp"
        app:layout_constraintWidth_percent="0.42"
        app:layout_constraintTop_toBottomOf="@id/buttonSelectDate"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Calories -->
    <TextView
        android:id="@+id/labelCalories"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="12dp"
        android:labelFor="@id/inputCalories"
        android:text="@string/calories_burned_kcal"
        android:textColor="#26134F"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/inputCalories"
        app:layout_constraintTop_toTopOf="@id/inputCalories"
        app:layout_constraintBottom_toBottomOf="@id/inputCalories" />

    <EditText
        android:id="@+id/inputCalories"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/input_box_background"
        android:hint="@string/calories"
        android:inputType="number"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#000000"
        android:textColorHint="#595466"
        android:textSize="16sp"
        app:layout_constraintWidth_percent="0.42"
        app:layout_constraintTop_toBottomOf="@id/inputSteps"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Water -->
    <TextView
        android:id="@+id/labelWater"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="12dp"
        android:labelFor="@id/inputWater"
        android:text="@string/water_intake_ml"
        android:textColor="#26134F"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/inputWater"
        app:layout_constraintTop_toTopOf="@id/inputWater"
        app:layout_constraintBottom_toBottomOf="@id/inputWater" />

    <EditText
        android:id="@+id/inputWater"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/input_box_background"
        android:hint="@string/water"
        android:inputType="number"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#000000"
        android:textColorHint="#595466"
        android:textSize="16sp"
        app:layout_constraintWidth_percent="0.42"
        app:layout_constraintTop_toBottomOf="@id/inputCalories"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/buttonSaveRecord"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:minHeight="48dp"
        android:text="@string/save_record"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/inputWater"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/addRecordIllustration"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="0dp"
        android:contentDescription="@null"
        android:scaleType="fitEnd"
        android:src="@drawable/add_record_illustration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>